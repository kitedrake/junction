<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Junction Driver Installer's launch daemon, registered by Junction with SMAppService.daemon (build.sh copies it into
     Junction.app/Contents/Library/LaunchDaemons). It runs as root while Junction asks it to install or remove the
     driver: launchd starts it when Junction connects to its XPC service, and it quits after a minute without requests.
     It also keeps the driver's per-app capture region for Junction (local.junction.driverd.capture): launchd starts it
     when the driver sends the region, and it stays while it holds one. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.junction.driverd</string>
  <key>BundleProgram</key><string>Contents/Library/HelperTools/JunctionDriverDaemon</string>
  <key>AssociatedBundleIdentifiers</key><array><string>local.junction.app</string></array>
  <key>MachServices</key><dict>
    <key>local.junction.driverd</key><true/>
    <key>local.junction.driverd.capture</key><true/>
  </dict>
</dict>
</plist>
